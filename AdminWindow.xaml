<Window x:Class="PrinterCartridgeApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Кабинет администратора" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <!-- ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ (в правом верхнем углу) -->
        <ToggleButton x:Name="ThemeToggle" Style="{StaticResource MaterialDesignActionToggleButton}" 
                      HorizontalAlignment="Right" VerticalAlignment="Top" 
                      ToolTip="Переключить тему"
                      Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked">
            <materialDesign:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="24" Height="24"/>
        </ToggleButton>

        <!-- Твой TabControl -->
        <TabControl Style="{StaticResource MaterialDesignTabControl}" Margin="0,40,0,0">

            <!-- ВКЛАДКА 1: ПАНЕЛЬ ПРИБОРОВ -->
            <TabItem Header="ПАНЕЛЬ ПРИБОРОВ">
                <Grid Margin="20">
                    <UniformGrid Columns="2" Rows="2" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Карточка 1: Всего заявок -->
                        <materialDesign:Card Margin="15" Padding="20" UniformCornerRadius="10" Background="#E3F2FD">
                            <StackPanel>
                                <TextBlock Text="ВСЕГО ЗАЯВОК" FontSize="16" Foreground="#1565C0" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalRequests" Text="0" FontSize="48" FontWeight="Bold" Foreground="#0D47A1" Margin="0,10,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Карточка 2: В работе -->
                        <materialDesign:Card Margin="15" Padding="20" UniformCornerRadius="10" Background="#FFF3E0">
                            <StackPanel>
                                <TextBlock Text="ТРЕБУЮТ ВНИМАНИЯ" FontSize="16" Foreground="#E65100" FontWeight="Bold"/>
                                <TextBlock x:Name="txtPendingRequests" Text="0" FontSize="48" FontWeight="Bold" Foreground="#BF360C" Margin="0,10,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Карточка 3: Выполнено -->
                        <materialDesign:Card Margin="15" Padding="20" UniformCornerRadius="10" Background="#E8F5E9">
                            <StackPanel>
                                <TextBlock Text="ВЫПОЛНЕНО" FontSize="16" Foreground="#2E7D32" FontWeight="Bold"/>
                                <TextBlock x:Name="txtCompletedRequests" Text="0" FontSize="48" FontWeight="Bold" Foreground="#1B5E20" Margin="0,10,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Карточка 4: Склад -->
                        <materialDesign:Card Margin="15" Padding="20" UniformCornerRadius="10" Background="#F3E5F5">
                            <StackPanel>
                                <TextBlock Text="КАРТРИДЖЕЙ НА СКЛАДЕ" FontSize="16" Foreground="#6A1B9A" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalStock" Text="0" FontSize="48" FontWeight="Bold" Foreground="#4A148C" Margin="0,10,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                    </UniformGrid>
                </Grid>
            </TabItem>
            <!-- ВКЛАДКА 2: Управление складом -->
            <TabItem Header="СКЛАД КАРТРИДЖЕЙ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Для плашки предупреждения -->
                        <RowDefinition Height="*"/>
                        <!-- Для таблицы -->
                        <RowDefinition Height="Auto"/>
                        <!-- Для кнопок -->
                    </Grid.RowDefinitions>

                    <!-- ПЛАШКА ПРЕДУПРЕЖДЕНИЯ (по умолчанию скрыта) -->
                    <Border Grid.Row="0" x:Name="pnlWarning" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" 
                CornerRadius="5" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="20" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Внимание! Запас некоторых картриджей подходит к концу (осталось 3 шт. или меньше). Пора заказать новую партию!" 
                           Foreground="#E65100" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ТАБЛИЦА СКЛАДА -->
                    <DataGrid Grid.Row="1" x:Name="dgInventory" Style="{StaticResource MaterialDesignDataGrid}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">

                        <!-- Стиль для оранжевой подсветки строк -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="1">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding InventoryID}" Width="50"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Кол-во на складе" Binding="{Binding Quantity}" Width="150" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Прогноз (недель)" Binding="{Binding WeeksLeft}" Width="130" FontWeight="SemiBold"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- КНОПКИ УПРАВЛЕНИЯ -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="btnAddStock" Content="ДОБАВИТЬ 1 ШТ." Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,15,0" Click="btnAddStock_Click"/>
                        <Button x:Name="btnRemoveStock" Content="СПИСАТЬ 1 ШТ." Style="{StaticResource MaterialDesignOutlinedButton}" Click="btnRemoveStock_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 3: Статистика и Отчеты -->
            <TabItem Header="СТАТИСТИКА И ОТЧЕТЫ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть: Кто сколько просил -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Активность пользователей" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" x:Name="dgUserStats" Style="{StaticResource MaterialDesignDataGrid}" 
          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuspicious}" Value="1">
                                            <Setter Property="Background" Value="#FFCDD2"/>
                                            <Setter Property="Foreground" Value="#B71C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Сотрудник" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Кол-во заявок" Binding="{Binding RequestCount}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Правая часть: Отчет за неделю -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Отчет по расходу" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="btnGenerateReport" Content="ПОКАЗАТЬ РАСХОД ЗА 7 ДНЕЙ" Style="{StaticResource MaterialDesignRaisedSecondaryButton}" Margin="0,0,10,0" Click="btnGenerateReport_Click"/>
                            <Button x:Name="btnExportExcel" Content="ЭКСПОРТ В EXCEL" Style="{StaticResource MaterialDesignRaisedButton}" Click="btnExportExcel_Click"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2" x:Name="dgReport" Style="{StaticResource MaterialDesignDataGrid}" 
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Картридж" Binding="{Binding CartridgeName}" Width="*"/>
                                <DataGridTextColumn Header="Израсходовано (шт)" Binding="{Binding UsedCount}" Width="150" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
