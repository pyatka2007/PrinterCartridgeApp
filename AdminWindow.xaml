<Window x:Class="PrinterCartridgeApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Кабинет администратора" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <TabControl Style="{StaticResource MaterialDesignTabControl}">

            <!-- ВКЛАДКА 1: Управление складом -->
            <TabItem Header="СКЛАД КАРТРИДЖЕЙ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Для плашки предупреждения -->
                        <RowDefinition Height="*"/>
                        <!-- Для таблицы -->
                        <RowDefinition Height="Auto"/>
                        <!-- Для кнопок -->
                    </Grid.RowDefinitions>

                    <!-- ПЛАШКА ПРЕДУПРЕЖДЕНИЯ (по умолчанию скрыта) -->
                    <Border Grid.Row="0" x:Name="pnlWarning" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" 
                CornerRadius="5" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="20" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Внимание! Запас некоторых картриджей подходит к концу (осталось 3 шт. или меньше). Пора заказать новую партию!" 
                           Foreground="#E65100" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ТАБЛИЦА СКЛАДА -->
                    <DataGrid Grid.Row="1" x:Name="dgInventory" Style="{StaticResource MaterialDesignDataGrid}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">

                        <!-- Стиль для оранжевой подсветки строк -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="1">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding InventoryID}" Width="50"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Кол-во на складе" Binding="{Binding Quantity}" Width="150" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Прогноз (недель)" Binding="{Binding WeeksLeft}" Width="130" FontWeight="SemiBold" Foreground="DarkBlue"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- КНОПКИ УПРАВЛЕНИЯ -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button x:Name="btnAddStock" Content="ДОБАВИТЬ 1 ШТ." Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,15,0" Click="btnAddStock_Click"/>
                        <Button x:Name="btnRemoveStock" Content="СПИСАТЬ 1 ШТ." Style="{StaticResource MaterialDesignOutlinedButton}" Click="btnRemoveStock_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 2: Статистика и Отчеты -->
            <TabItem Header="СТАТИСТИКА И ОТЧЕТЫ">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть: Кто сколько просил -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Активность пользователей" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" x:Name="dgUserStats" Style="{StaticResource MaterialDesignDataGrid}" 
          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuspicious}" Value="1">
                                            <Setter Property="Background" Value="#FFCDD2"/>
                                            <Setter Property="Foreground" Value="#B71C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Сотрудник" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Кол-во заявок" Binding="{Binding RequestCount}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Правая часть: Отчет за неделю -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Отчет по расходу" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Button Grid.Row="1" x:Name="btnGenerateReport" Content="ПОКАЗАТЬ РАСХОД ЗА 7 ДНЕЙ" Style="{StaticResource MaterialDesignRaisedSecondaryButton}" Margin="0,0,0,15" Click="btnGenerateReport_Click"/>

                        <DataGrid Grid.Row="2" x:Name="dgReport" Style="{StaticResource MaterialDesignDataGrid}" 
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Картридж" Binding="{Binding CartridgeName}" Width="*"/>
                                <DataGridTextColumn Header="Израсходовано (шт)" Binding="{Binding UsedCount}" Width="150" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
