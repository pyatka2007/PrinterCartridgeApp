<Window x:Class="PrinterCartridgeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Вход в систему" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <!-- КНОПКА ПЕРЕКЛЮЧЕНИЯ ТЕМЫ -->
        <ToggleButton x:Name="ThemeToggle" Style="{StaticResource MaterialDesignActionToggleButton}" 
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                  Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked">
            <materialDesign:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="24" Height="24"/>
        </ToggleButton>

        <!-- Декоративные элементы на фоне -->
        <Ellipse Width="300" Height="300" Fill="#33D500F9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="50,0,0,50"/>
        <Ellipse Width="200" Height="200" Fill="#336200EE" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,100,0"/>

        <!-- Карточка авторизации по центру -->
        <materialDesign:Card Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" UniformCornerRadius="15">
            <materialDesign:Card.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
            </materialDesign:Card.Effect>

            <StackPanel>
                <TextBlock Text="Учёт картриджей" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Вход в систему" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Поле Логин -->
                <TextBox x:Name="txtLogin" materialDesign:HintAssist.Hint="Логин" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20" FontSize="16"/>

                <!-- Поле Пароль -->
                <PasswordBox x:Name="txtPassword" materialDesign:HintAssist.Hint="Пароль" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,0,0,30" FontSize="16"/>

                <!-- Кнопка Войти -->
                <Button x:Name="btnLogin" Content="ВОЙТИ" Style="{StaticResource MaterialDesignRaisedButton}" Height="45" FontSize="16" Click="btnLogin_Click"/>

                <!-- Текст ошибки (скрыт по умолчанию) -->
                <TextBlock x:Name="txtError" Text="Неверный логин или пароль" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>