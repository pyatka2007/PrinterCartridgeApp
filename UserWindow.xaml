<Window x:Class="PrinterCartridgeApp.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Кабинет пользователя" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ -->
        <ToggleButton x:Name="ThemeToggle" Style="{StaticResource MaterialDesignActionToggleButton}" 
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,10,0"
                      Grid.ColumnSpan="2" Panel.ZIndex="1"
                      Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked">
            <materialDesign:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="24" Height="24"/>
        </ToggleButton>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Создание/Редактирование заявки -->
        <materialDesign:Card Grid.Column="0" Padding="20" Margin="0,0,20,0" UniformCornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="txtFormTitle" Text="Новая заявка" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Выберите картриджи:" Margin="0,0,0,5" Foreground="Gray"/>
                <!-- Сюда код будет добавлять CheckBox -->
                <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                    <StackPanel x:Name="pnlCartridges"/>
                </ScrollViewer>

                <TextBlock Text="Номер кабинета" Margin="0,0,0,5" Foreground="Gray"/>
                <TextBox x:Name="txtRoom" materialDesign:HintAssist.Hint="Например: 3" Margin="0,0,0,30" FontSize="14"/>

                <Button x:Name="btnSubmitRequest" Content="ОТПРАВИТЬ ЗАЯВКУ" Style="{StaticResource MaterialDesignRaisedButton}" Height="45" FontSize="14" Click="btnSubmitRequest_Click"/>
                <Button x:Name="btnCancelEdit" Content="ОТМЕНИТЬ РЕДАКТИРОВАНИЕ" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,10,0,0" Visibility="Collapsed" Click="btnCancelEdit_Click"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- ПРАВАЯ ПАНЕЛЬ: История заявок (Вкладки) -->
        <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="10">
            <TabControl Style="{StaticResource MaterialDesignTabControl}">

                <!-- ВКЛАДКА 1: Активные заявки -->
                <TabItem Header="АКТИВНЫЕ">
                    <Grid Margin="0,10,0,0">
                        <DataGrid x:Name="dgActiveRequests" Style="{StaticResource MaterialDesignDataGrid}" 
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="dgActiveRequests_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding RequestID}" Width="50"/>
                                <DataGridTextColumn Header="Картриджи" Binding="{Binding CartridgeNames}" Width="*"/>
                                <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomNumber}" Width="80"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Дважды кликните по заявке со статусом 'Новая', чтобы отредактировать её" VerticalAlignment="Bottom" HorizontalAlignment="Center" Foreground="Gray" FontStyle="Italic" Margin="0,0,0,-20"/>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА 2: Выполненные заявки -->
                <TabItem Header="ВЫПОЛНЕННЫЕ">
                    <DataGrid x:Name="dgCompletedRequests" Style="{StaticResource MaterialDesignDataGrid}" 
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding RequestID}" Width="50"/>
                            <DataGridTextColumn Header="Картриджи" Binding="{Binding CartridgeNames}" Width="*"/>
                            <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomNumber}" Width="80"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>